# Any OpenAI-compatible chat endpoint. Examples:
#
# Google AI Studio (free Gemma / Gemini):
#   LLM_API_KEY=AIzaSy...
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
